@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
# 不下载依赖或升级编译器, 与当前发行归档使用的固定 ABI 保持一致.
if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" OR NOT CMAKE_CXX_COMPILER_ID STREQUAL "GNU" OR NOT CMAKE_CXX_COMPILER_VERSION VERSION_EQUAL 16.2.0)
    set(Comet_FOUND FALSE)
    set(Comet_NOT_FOUND_MESSAGE "Comet currently requires Linux and GCC 16.2.0")
    return()
endif()
set(ZLIB_USE_STATIC_LIBS ON)
find_dependency(Threads)
find_dependency(Protobuf 36.1.0 EXACT CONFIG)
find_dependency(gRPC 1.84.0 EXACT CONFIG)
include("${CMAKE_CURRENT_LIST_DIR}/CometTargets.cmake")
check_required_components(Comet)
