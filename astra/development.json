        "GOMODCACHE": "{cache}/deps/go/pkg/mod",
        "GOCACHE": "{root}/build/cache/go",
        "TMPDIR": "{run}/tmp",
        "GOPROXY": "off",
        "GOSUMDB": "off",
        "GOTOOLCHAIN": "local",
        "GOWORK": "off",
        "GOFLAGS": "-mod=readonly",
        "PATH": "{cache}/tools/go-1.27.1/bin:{cache}/tools/gcc-16.2.0/bin:/usr/bin:/bin",
        "CC": "{cache}/tools/gcc-16.2.0/bin/gcc",
        "CXX": "{cache}/tools/gcc-16.2.0/bin/g++",
        "LD_LIBRARY_PATH": "{cache}/tools/gcc-16.2.0/lib64"
      },
      "package": "github.com/eosforge/astra/polaris/internal/storage",
      "expected_tests": [
        "TestAtomicity",
        "TestBatchEncoding",
        "TestBatchPersistence",
        "TestBatchRollback",
        "TestBatchSnapshot",
        "TestCancellation",
