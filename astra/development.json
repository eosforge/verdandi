      "contracts": [
        {
          "id": "STORAGE-ATOMIC",
          "statement": "同一 scope 一版本多键提交后, 快照与回放保留整个批次; 此检查只证明受控串行样例, 并发交错另列缺口."
        },
        {
          "id": "STORAGE-RETRY",
          "statement": "同版本同内容重试不增加历史; 同版本异内容拒绝且状态不变."
        },
        {
          "id": "STORAGE-ROLLBACK",
          "statement": "第二条 SQL 插入失败后, 第一条更新、版本和历史都回滚; 解除故障后可提交."
        },
        {
          "id": "STORAGE-HISTORY",
          "statement": "有界历史拒绝落后游标, 保留连续后缀; 正常关闭重开保持数据与版本, 不代替断电耐久."
        },
        {
          "id": "STORAGE-ASSURANCE",
          "statement": "组件完整维护准入: 规范全部适用规则及 L3 覆盖、独立模型、故障、变异和交付矩阵. 首次接入不据已有测试反推完整性."
        }
      ],
