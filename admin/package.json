{
  "name": "verdandi-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "type-check": "vue-tsc --noEmit",
    "build": "pnpm type-check && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "pnpm format:check && pnpm check:boundaries && pnpm test && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "naive-ui": "2.45.3",
    "three": "0.185.0",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@types/three": "0.185.4",
    "@vitejs/plugin-vue": "6.0.8",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vue-tsc": "3.3.11"
  }
}
