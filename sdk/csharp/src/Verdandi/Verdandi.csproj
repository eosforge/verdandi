<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>Verdandi</AssemblyName>
    <RootNamespace>Verdandi</RootNamespace>
    <Version>0.1.0</Version>
    <Authors>LaconisIves</Authors>
    <Description>Managed C# facade for the Verdandi distributed coordination runtime.</Description>
    <PackageId>Verdandi</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/eosforge/verdandi</PackageProjectUrl>
    <RepositoryUrl>https://github.com/eosforge/verdandi.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Verdandi.Tests" />
  </ItemGroup>
</Project>
